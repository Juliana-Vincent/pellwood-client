# MongoDB
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Payment Gateway (Comgate merchant id / secret)
PAYED_ID=your_payment_id
PAYED_PASSWORD=your_payment_password

# Zbozi.cz conversion tracking
ZBOZI_PRIVATE_KEY=your_zbozi_private_key

# Comgate webhook verification (see src/pages/api/payment/index.ts)
COMGATE_WEBHOOK_SECRET=your_comgate_webhook_secret

# Google OAuth for Email
GOOGLE_SECRET=your_google_oauth_secret
GOOGLE_ID=your_google_oauth_client_id
GOOGLE_REFRESH=your_google_oauth_refresh_token

# Application
NODE_ENV=production
PORT=3001
