# MongoDB (orders/users)
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Strapi CMS
NEXT_PUBLIC_STRAPI_API_URL=https://cms.pellwood.com

# Session cookies (order/account auth) - generate with: openssl rand -hex 32
SESSION_SECRET=your_random_session_secret

# Payment Gateway (Comgate merchant id / secret)
PAYED_ID=your_payment_id
PAYED_PASSWORD=your_payment_password

# Zbozi.cz conversion tracking
ZBOZI_PRIVATE_KEY=your_zbozi_private_key

# Google Analytics 4 (GA4) Measurement ID - format G-XXXXXXXXXX. Analytics scripts
# are only rendered when this is set (see layout/Page.tsx); leave unset to ship with
# no analytics at all instead of a broken/empty gtag call.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email delivery - pick one; the API checks them in this order and falls back
# through Resend -> SendGrid -> Gmail (see src/pages/api/send/orderInfo.ts)
RESEND_API_KEY=your_resend_api_key
SENDGRID_API_KEY=your_sendgrid_api_key
GMAIL_APP_PASSWORD=your_gmail_app_password
# Gmail OAuth2 fallback, only used if GMAIL_APP_PASSWORD is not set
GOOGLE_ID=your_google_oauth_client_id
GOOGLE_SECRET=your_google_oauth_secret
GOOGLE_REFRESH=your_google_oauth_refresh_token

# Application
NODE_ENV=production
PORT=3001
