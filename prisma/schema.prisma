generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  // Text id, not a native uuid column: legacy orders carry 24-char Mongo
  // ObjectId hex strings, and text accepts those as-is if they're ever imported.
  id String @id @default(uuid())

  email   String @default("")
  phone   String @default("")
  name    String @default("")
  surname String @default("")

  currency String @default("")
  country  String @default("")
  city     String @default("")
  address  String @default("")
  code     String @default("")

  anotherAddressCheck Boolean @default(false)
  companyDataCheck    Boolean @default(false)

  // Kept as Json (and kept misspelled - see note below) so no other file changes.
  anotherAdress Json?
  companyData   Json?

  // Comgate refId + public order-lookup key. A sequence makes uniqueness
  // structural, so the random-and-retry loop in the route goes away.
  idOrder Int @unique @default(autoincrement())

  status String @default("")
  state  String @default("new")
  note   String @default("")

  basket Json?

  // Was a String in Mongoose, which meant no arithmetic without parsing and no
  // way to SUM in the DB. Decimal, not Float: money in binary floating point
  // accumulates error.
  sum Decimal @default(0) @db.Decimal(10, 2)

  // These two stay String on purpose - they can hold "ZDARMA", not just digits.
  paymentPrice  String @default("")
  deliveryPrice String @default("")

  paymentMethod  String  @default("")
  deliveryMethod String  @default("")
  payOnline      Boolean @default(false)

  notified Boolean @default(false)

  // New field. Mongoose had no timestamps at all, so right now there is no way
  // to sort orders by age or find "today's orders".
  createdAt DateTime @default(now())

  @@index([email]) // api/order/email/[email].ts looks up by this
  @@map("orders")
}

model User {
  id String @id @default(uuid())

  // Unique, unlike the Mongo version. Login and password reset both look up by
  // email; two rows with the same address is a silent account-takeover path.
  email String @unique

  phone    String @default("")
  password String @default("")
  name     String @default("")
  surname  String @default("")
  country  String @default("")
  city     String @default("")
  address  String @default("")
  code     String @default("")

  anotherAdress Json?
  companyData   Json?

  resetTokenHash    String?   @unique
  resetTokenExpires DateTime?

  createdAt DateTime @default(now())

  @@map("users")
}
